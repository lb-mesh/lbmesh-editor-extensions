{
  "name": "lbmesh-vscode",
  "displayName": "LBMesh",
  "description": "Schema IntelliSense, snippets, and pre-flight linting for LBMesh recipes.",
  "version": "0.0.1",
  "publisher": "lbmesh",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "**/.lbmesh/recipe.yaml",
        "url": "./schemas/recipe.v1.json"
      },
      {
        "fileMatch": "**/.lbmesh/recipe.yml",
        "url": "./schemas/recipe.v1.json"
      },
      {
        "fileMatch": "**/recipe.lbmesh.yaml",
        "url": "./schemas/recipe.v1.json"
      },
      {
        "fileMatch": "**/recipe.lbmesh.yml",
        "url": "./schemas/recipe.v1.json"
      },
      {
        "fileMatch": "**/lbmesh.yaml",
        "url": "./schemas/recipe.v1.json"
      },
      {
        "fileMatch": "**/lbmesh.yml",
        "url": "./schemas/recipe.v1.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": "**/.lbmesh/recipe.yaml",
        "url": "./schemas/recipe.v1.json"
      },
      {
        "fileMatch": "**/.lbmesh/recipe.yml",
        "url": "./schemas/recipe.v1.json"
      },
      {
        "fileMatch": "**/recipe.lbmesh.yaml",
        "url": "./schemas/recipe.v1.json"
      },
      {
        "fileMatch": "**/recipe.lbmesh.yml",
        "url": "./schemas/recipe.v1.json"
      },
      {
        "fileMatch": "**/lbmesh.yaml",
        "url": "./schemas/recipe.v1.json"
      },
      {
        "fileMatch": "**/lbmesh.yml",
        "url": "./schemas/recipe.v1.json"
      }
    ],
    "snippets": [
      {
        "language": "yaml",
        "path": "./snippets/lbmesh-snippets.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "package": "npm run check-types && node scripts/build.js --production",
    "check-types": "tsc --noEmit",
    "compile-tests": "tsc -p . --outDir out",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.js\"",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "~1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.23.1",
    "eslint": "^8.57.0",
    "mocha": "^10.7.3",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  }
}
